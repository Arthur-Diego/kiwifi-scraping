# ==============================
# Ambientes virtuais (padrao unico: .venv)
# ==============================
.venv/
venv/
venv*/
env*/
ENV*/
.venv-linux/
.venv-wsl/
venv-project-kiwifi/

# Gerenciador de versao do Python (ferramenta, fora do versionamento)
.pyenv/

# ==============================
# Quarentena (expurgo gradual)
# ==============================
_quarantine/

# Codigo legado: mantido no disco (ignorado, como antes) porque
# tests/regression/test_legacy_vs_new_regression.py importa de backup_legacy.
backup_legacy/

# ==============================
# Caches e artefatos do Python
# ==============================
__pycache__/
*.py[cod]
*.p~
*.swp
.pytest_cache/

# Build e distribuicao
build/
dist/
*.egg-info/

# ==============================
# IDEs
# ==============================
.idea/
*.iml

# ==============================
# Artefatos do Windows / SO
# ==============================
*.Zone.Identifier
.DS_Store
Thumbs.db

# ==============================
# Logs e exports (regeneraveis)
# ==============================
logs/
*.log
exports/

# ==============================
# Dados gerados / bases locais
# ==============================
data/
data/*.db
*.db
*.sqlite
*.jsonl
*.csv
*.parquet

# ==============================
# Dados de runtime (NAO versionar; mantidos na raiz para os mounts do compose)
# ==============================
postgres_data/
qdrant_storage/
qdrant_snapshots/

# ==============================
# Segredos e ambiente
# ==============================
.env
*.env
.env.*
!.env.example

# ==============================
# Documentacao quarentenada (context_llm e a fonte canonica)
# ==============================
context/

# Arquivos temporarios
*.tmp
*.bak
