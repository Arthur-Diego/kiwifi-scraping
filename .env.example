OPENAI_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kiwifi-rag

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chat_history
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Product mining
PRODUCT_MINING_SOURCE_FILE=context_llm/product_mining_candidates.seed.json
PRODUCT_MINING_USE_LOCAL_SOURCE=1
PRODUCT_MINING_ENABLE_SCRAPING=1
PRODUCT_MINING_SCRAPING_TIMEOUT_SECONDS=12
PRODUCT_MINING_SCRAPING_MAX_WORKERS=6

# Selenium session helper (manual login once, then reuse session)
SELENIUM_LOGIN_URL=https://accounts.clickbank.com/master/sign-in
SELENIUM_TARGET_URL=https://accounts.clickbank.com/master/mktplace
SELENIUM_SUCCESS_SELECTOR=#profile-popover
SELENIUM_SUCCESS_URL_CONTAINS=/master/dashboard
SELENIUM_LOGIN_USERNAME=
SELENIUM_LOGIN_PASSWORD=
SELENIUM_USERNAME_SELECTOR=input[name='username']
SELENIUM_PASSWORD_SELECTOR=input[name='password']
SELENIUM_SUBMIT_SELECTOR=form#sign-in button[type='submit']
SELENIUM_COOKIE_FILE=data/reports/selenium_session_cookies.json
SELENIUM_PROFILE_DIR=data/reports/selenium_profile
SELENIUM_LOGIN_TIMEOUT_SECONDS=300
SELENIUM_OPEN_AFFILIATE_MARKETPLACE=1
SELENIUM_AFFILIATE_MARKETPLACE_SELECTOR="a[title='Affiliate Marketplace']"
SELENIUM_MARKETPLACE_WAIT_SECONDS=20
SELENIUM_SCRAPE_MARKETPLACE=1
SELENIUM_MARKETPLACE_PAGES=5
SELENIUM_MARKETPLACE_OUTPUT_FILE=data/reports/clickbank_marketplace_top_offers.json
